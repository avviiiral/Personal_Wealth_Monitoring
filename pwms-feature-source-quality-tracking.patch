+              <span class="sub-class-tag">{{ row.sub_class }}</span>
+            </td>
+
+            <td>{{ row.asset_class }}</td>
+
+            <td>{{ row.family_name || '-' }}</td>
+
+            <td>{{ row.advisors || '-' }}</td>
+
+            <td>{{ row.amc_name || '-' }}</td>
