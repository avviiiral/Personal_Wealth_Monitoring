+            <td class="numeric" [ngClass]="getPnlClass(row.xirr)">
+              {{ formatPercentage(row.xirr) }}
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+
+    <div class="pagination" *ngIf="filteredRows.length > 0">
+      <span class="pagination-summary">
+        {{ pageStart }}–{{ pageEnd }} of {{ filteredRows.length }}
+      </span>
+
+      <div class="pagination-controls">
+        <button type="button" [disabled]="page <= 1" (click)="goToPage(page - 1)">Prev</button>
+
+        <span class="pagination-page">Page {{ page }} of {{ totalPages }}</span>
+
+        <button type="button" [disabled]="page >= totalPages" (click)="goToPage(page + 1)">
+          Next
+        </button>
+      </div>
+    </div>
